# Versión de comparación para la pregunta de discusión del Paso 4.
# COPY . . va ANTES de pip install: cualquier cambio en app.py invalida
# la capa de dependencias y obliga a reinstalarlas. NO usar en producción.
FROM python:3.14-slim
WORKDIR /app
COPY . .
RUN pip install --no-cache-dir -r requirements.txt
RUN useradd --system --no-create-home app
USER app
ENV NAME=World
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --start-interval=2s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health', timeout=2)"
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "2", "--no-control-socket", "app:app"]
